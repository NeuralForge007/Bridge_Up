# ==============================================================================
# BridgeUp: Master Environment Configuration Template (.env.example)
# Note: Copy to .env and supply your local or production credentials.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Frontend Configuration (Vite / React)
# ------------------------------------------------------------------------------
VITE_API_BASE_URL=http://localhost:5001/api
VITE_API_URL=http://localhost:5001/api

# ------------------------------------------------------------------------------
# 2. Backend Configuration (Express / Node.js)
# ------------------------------------------------------------------------------
PORT=5001
JWT_SECRET=your_secure_jwt_secret_key_change_in_production
AI_SERVICE_URL=http://127.0.0.1:8001
AI_REQUEST_TIMEOUT_MS=15000
AI_HEALTH_TIMEOUT_MS=2000
RUN_SEED_ON_START=false
ENABLE_DEMO_LOGIN=true

# Supabase Credentials (Cloud PostgreSQL & Realtime REST API)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_secret_key
SUPABASE_ANON_KEY=your_supabase_anon_public_key

# ------------------------------------------------------------------------------
# 3. AI Recommender Service Configuration (FastAPI / Sentence-BERT / pgvector)
# ------------------------------------------------------------------------------
AI_SERVICE_HOST=127.0.0.1
AI_SERVICE_PORT=8001
SBERT_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIM=384
MAX_VECTOR_CANDIDATES=30
LOG_LEVEL=INFO
# SENTENCE_TRANSFORMERS_HOME=/path/to/persistent/model/cache
